# Perxona Connect Kit — Environment Variables
# ─────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values (create your API keys in the Perxona console, under
#    Organization > Integration > Connect API keys — see README)
# 3. Start the server: npm start

# ── Required ───────────────────────────────────────────────────────────────

# Perxona API base URL. Leave this as-is unless you know your Perxona Console
# account is in a different region — changing it to a region your account
# isn't in will fail every request.
PERXONA_API_BASE_URL=https://console.perxona.ai/asia

# Perxona Connect API keys. Two of them, and they are not interchangeable —
# create both at https://console.perxona.ai, under Organization > Integration >
# Connect API keys. Each key is shown once and never again, so copy it here
# before closing the dialog. Every visitor to this sample shares this one
# Connect identity; there is no per-user sign-in.
#
#   SECRET      authenticates this server. It can talk to your chatbots and
#               manage them, and publish avatars into your organization, so it
#               must never leave the server.
#   PUBLISHABLE is handed to the browser, which passes it to the presenter. It
#               can read your catalog, generate presentations, and mint speech
#               tokens — the last two bill your organization.
#
# Leave the SECRET key's allowed-domain list EMPTY. A domain restriction is
# matched against the browser's Origin header, which a server-to-server request
# never sends — so a secret key with domains configured is refused on every
# call. The error says only that the origin is not allowed; it never names one,
# because nothing was sent. Domain restrictions belong on the publishable key,
# which really is used by a browser.
PERXONA_CONNECT_SECRET_KEY=
PERXONA_CONNECT_PUBLISHABLE_KEY=

# ── Optional ───────────────────────────────────────────────────────────────

# Server port (default: 8083)
PORT=8083

# Run without keys or network: serves a fake catalog so you can browse
# the UI, but cannot drive the presenter or the chatbot routes, which return
# 501. Both demos say so rather than appearing broken.
# USE_MOCK=true

# "production" enables ETags on the static frontend. Anything else (the
# default) disables them, so a plain browser refresh always picks up an edited
# demo file instead of a cached one.
# NODE_ENV=development

# Perxona presenter engine URL (CDN). Must match the region in
# PERXONA_API_BASE_URL above — leaving them on different regions is the one
# combination that looks configured and is not. Omit this line entirely and
# the server falls back to the region-neutral production engine.
PRESENTER_URL=https://cdn.perxona.ai/asia/prod/latest/widget/entry/presenter.js


# ── Embed demo target (all optional) ─────────────────────────────────────
# Used by /demos/embed/ only. Studio has pickers and ignores these entirely.
#
# Leave everything blank and the server picks the first avatar, scene, voice and
# chatbot in your account, so /demos/embed/ runs with no setup at all. Fill them
# in to pin your own — that is what a real integration's config looks like, and
# it is the only reason these exist.
#
# Two details, if you do fill them in:
#   • avatar + scene go together. One without the other is ignored.
#   • a blank voice then means BYO-TTS (you supply audio via presentWithAudio).
#     The auto-pick always includes one, because present() fails without it.
#
# Find IDs in /demos/studio/'s pickers, or from GET /api/avatars, /api/scenes,
# /api/voices. No chatbot yet? Create one in /demos/studio/ — it opens the form
# prefilled, and Embed picks it up on the next page load.
DEMO_FIXED_AVATAR_ID=
DEMO_FIXED_SCENE_ID=
DEMO_FIXED_VOICE_ID=
DEMO_FIXED_CHATBOT_ID=

# ── LLM chat integration (Option C — disabled by default) ──────────────────
# Leave LLM_API_KEY blank to keep chat disabled (safe default, no key required)
# Fill in to enable the chat panel → avatar answers questions
LLM_API_KEY=
# Provider protocol: openai (Chat Completions) or anthropic (Claude Messages API)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Local & free (Ollama): LLM_BASE_URL=http://localhost:11434/v1  (no key needed)
# Claude: LLM_PROVIDER=anthropic, LLM_BASE_URL=https://api.anthropic.com, LLM_MODEL=claude-sonnet-4-20250514
