# Production Perxona Connect API
VITE_PERXONA_API_BASE_URL=https://console.perxona.ai/asia

# Production presenter engine CDN
VITE_PRESENTER_URL=https://cdn.perxona.ai/asia/prod/latest/widget/entry/presenter.js

# Connect publishable API key — create one at
# https://console.perxona.ai/asia/organization/integration/connect-api-keys/
# (use the console region matching VITE_PERXONA_API_BASE_URL above). Safe to
# embed in a browser bundle,
# but only once its allowed domains are set: with none set, anyone who reads
# the key out of the bundle can call the API from anywhere, billed to your
# organization (this key carries presentation/tts_token write access). Note
# allowed domains must be a real FQDN — localhost can never be one — so local
# dev needs its own domain-unrestricted key, separate from any deployed key.
VITE_PERXONA_CONNECT_PUBLISHABLE_KEY=
